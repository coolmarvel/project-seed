{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/env-guard.sh",
            "blocking": true,
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/git-add-guard.sh",
            "blocking": true,
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
